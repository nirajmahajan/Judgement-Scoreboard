<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/score_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <View android:id="@+id/status_bar_background" android:layout_width="match_parent"
        android:layout_height="0dp" android:background="@color/score_table_header" />
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" app:title="@string/app_name"
        android:background="@color/score_table_header"
        app:titleTextColor="@color/score_table_on_header" app:navigationIconTint="@color/score_table_on_header" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/screen_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingHorizontal="16dp" android:paddingBottom="16dp"
            android:scrollbars="vertical" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/add_saved_player" android:layout_width="56dp" android:layout_height="56dp"
            android:layout_gravity="bottom|end" android:layout_margin="16dp"
            android:contentDescription="@string/add_saved" android:src="@drawable/ic_score_add"
            android:visibility="gone" app:fabSize="normal" app:useCompatPadding="false"
            app:backgroundTint="?attr/colorPrimary" app:tint="?attr/colorOnPrimary"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Score.Circle" />
    </FrameLayout>
    <LinearLayout android:id="@+id/fixed_actions"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:paddingVertical="4dp"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/home_help" style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="start" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"
        android:minWidth="0dp" android:minHeight="48dp" android:paddingHorizontal="12dp"
        android:text="@string/help" android:visibility="gone" />
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone"
        app:labelVisibilityMode="labeled" app:menu="@menu/score_navigation" />
</LinearLayout>
