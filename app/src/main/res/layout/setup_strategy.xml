<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_strategy" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp" android:visibility="gone">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:labelFor="@id/setup_strategy_choices" android:paddingBottom="4dp" android:text="@string/setup_strategy_label"
        android:textAppearance="?attr/textAppearanceLabelLarge" />
    <com.google.android.material.button.MaterialButton android:id="@+id/setup_strategy_choices"
        style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="start|center_vertical" android:textAllCaps="false" />
</LinearLayout>
