<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:paddingHorizontal="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@id/row_name" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center_vertical"
            android:singleLine="true" android:ellipsize="end" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <FrameLayout android:layout_width="104dp" android:layout_height="match_parent">
            <TextView android:id="@id/row_detail" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:textAppearance="?attr/textAppearanceBodyLarge" />
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/bid_input"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:inputType="number" android:singleLine="true" android:gravity="center"
                android:imeOptions="actionDone" android:hint="@string/table_bid"
                android:saveEnabled="false" android:textAppearance="?attr/textAppearanceBodyLarge" />
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/bid_confirm"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" app:tint="?attr/colorPrimary" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" />
</LinearLayout>
