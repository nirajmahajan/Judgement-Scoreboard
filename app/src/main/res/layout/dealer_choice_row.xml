<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
    android:importantForAccessibility="no" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground">
    <RadioButton android:id="@+id/dealer_choice_radio" android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp" />
    <TextView android:id="@id/row_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:importantForAccessibility="no" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textAppearance="?attr/textAppearanceBodyLarge" />
</LinearLayout>