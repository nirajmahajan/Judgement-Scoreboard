<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginVertical="4dp" app:cardBackgroundColor="@color/score_surface"
    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/score_border">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/row_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium"
            android:breakStrategy="simple" android:hyphenationFrequency="none" />
        <TextView android:id="@+id/row_detail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
        <LinearLayout android:id="@+id/row_actions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
